# ==============================================================================
# Backend FastAPI - Exemplo de Variaveis de Ambiente (Template Seguro)
# NUNCA insira senhas reais neste arquivo. Copie para .env local.
# ==============================================================================

# Credenciais e Conexao com Oracle 23ai Free
APP_DB_USER=OWNER_ODONTO
APP_DB_PASSWORD=sua_senha_forte_aqui
APP_DB_SERVICE=FREEPDB1
ORACLE_HOST=localhost
ORACLE_PORT=1521

# Aliases de Conexao DSN (Opcional)
ORACLE_USER=OWNER_ODONTO
ORACLE_PASSWORD=sua_senha_forte_aqui
ORACLE_DSN=localhost:1521/FREEPDB1

# Seguranca & JWT (Gere uma chave com: openssl rand -hex 32)
SECRET_KEY=gere_uma_chave_com_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Pool de Conexoes Oracle (Modo Thin)
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
