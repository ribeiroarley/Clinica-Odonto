# Oracle 23ai Free Engine Configuration (SYS / SYSTEM)
ORACLE_PWD=OdontoRoot#2026
ORACLE_CHARACTERSET=AL32UTF8
ORACLE_PORT=1521
ORACLE_OEM_PORT=5500

# Application Database Credentials & Service (PDB)
APP_DB_USER=OWNER_ODONTO
APP_DB_PASSWORD=OdontoApp#2026
APP_DB_SERVICE=FREEPDB1
ORACLE_HOST=localhost

# Backend Security & JWT Token (Gere com openssl rand -hex 32)
SECRET_KEY=odonto_secret_jwt_key_2026_super_secure_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
